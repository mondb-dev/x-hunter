<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sebastian.browser</string>

    <key>ProgramArguments</key>
    <!-- Chrome for Testing, NOT /Applications/Google Chrome.app.
         The desktop browser and that bundle share the bundle identifier
         com.google.Chrome, so while a headless process from it is alive macOS
         LaunchServices routes the user's Chrome launch to this windowless
         process and their browser never opens a window. Chrome for Testing has
         its own id (com.google.chrome.for.testing), so both run side by side.
         Profile is a matching sibling dir seeded from the old one's cookies. -->
    <array>
        <string>/Users/mondb/.local/bin/chrome-hunter</string>
        <string>--remote-debugging-port=18801</string>
        <string>--user-data-dir=/Users/mondb/.config/chrome-for-testing/x-hunter</string>
        <string>--no-first-run</string>
        <string>--no-default-browser-check</string>
        <string>--headless=new</string>
        <string>--disable-dev-shm-usage</string>
        <string>--disable-background-networking</string>
        <string>--disable-sync</string>
        <string>--disable-extensions</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/mondb</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mondb/hunter/runner/browser.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mondb/hunter/runner/browser.log</string>
</dict>
</plist>
